    "build:views": "tsx scripts/build-views.ts",
    "dev:panel": "vite --config vite.panel.config.ts",
    "build:panel": "vite build --config vite.panel.config.ts",
    "dev:stdio": "tsx src/server/stdio.ts",
    "dev:http": "tsx watch src/server/http.ts",
    "start:http": "node dist/server/http.js",
    "start": "node dist/server/stdio.js",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build:views",
    "smoke": "tsx scripts/smoke-stdio.ts",
    "inspect": "npx @modelcontextprotocol/inspector@latest npx tsx src/server/stdio.ts"
